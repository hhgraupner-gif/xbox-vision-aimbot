// ============================================================
// eRayz Anti-Recoil + Aim Slowdown — Titan Two GPC2
// ============================================================
// Standalone Script — braucht KEINEN PC, KEINEN KMBox!
//
// Features:
//   - Anti-Recoil (nur beim Schiessen)
//   - Aim-Slowdown beim ADS (praeziseres Zielen)
//
// Installation:
//   1. Gtuner IV -> File -> Open -> diese Datei
//   2. F5 (oder Compiler -> Compile)
//   3. Wenn "Compile OK" -> Drag & Drop auf Memory Slot
//
// Anpassung:
//   - RECOIL_V: Hoeher = mehr Kompensation (15-45)
//   - ADS_SLOW: Kleiner = langsamer beim ADS (0.5 = halb)
// ============================================================

#pragma METAINFO("eRayz Anti-Recoil", 1, 0, "eRayz")

// === EINSTELLUNGEN (anpassen pro Waffe!) ===
// AR/LMG: 25-35 | SMG: 15-22 | Sniper: 0
#define RECOIL_V  25.0
#define RECOIL_H   0.0
#define ADS_SLOW   0.60

main {
    // Anti-Recoil: Nur wenn RT (Fire) gedrueckt
    if (get_val(BUTTON_5) > 0.0) {
        set_val(STICK_1_Y, get_val(STICK_1_Y) + RECOIL_V);

        if (RECOIL_H != 0.0) {
            set_val(STICK_1_X, get_val(STICK_1_X) + RECOIL_H);
        }
    }

    // ADS Slowdown: Langsamer zielen wenn LT gedrueckt
    if (get_val(BUTTON_8) > 0.0) {
        set_val(STICK_1_X, get_val(STICK_1_X) * ADS_SLOW);
        set_val(STICK_1_Y, get_val(STICK_1_Y) * ADS_SLOW);
    }
}
