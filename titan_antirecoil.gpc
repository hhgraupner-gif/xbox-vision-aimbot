// ============================================================
// eRayz TITAN TWO v3 — Ultimate Aimbot + Aim Assist + Anti-Recoil
// ============================================================
// KMBox Net (INPUT-A) + Xbox Controller (INPUT-B)
// Input Translator laeuft separat in Gtuner IV (Test and Debug)
//
// NEU in v3:
//   - Dynamic Anti-Recoil (wird staerker je laenger du feuerst)
//   - Aim Assist NUR im ADS (nicht beim Hipfire-Schiessen)
//   - Rotational AA mit Richtungswechsel-Timer
//   - Anti-Recoil NUR bei ADS+Fire (kein Hipfire pull-down)
//   - Polar Circle kleiner = unsichtbarer in Killcam
//   - 1ms Response kompatibel
// ============================================================

#pragma METAINFO("eRayz_v3", 3, 0, "eRayz")

// === ANTI-RECOIL ===
#define RECOIL_V       12.0    // Vertikal (konstant)
#define RECOIL_H        0.0    // Horizontal

// === STICKY AIM ASSIST (Polar Circle) ===
#define AA_STRENGTH     3.5    // Radius
#define AA_SPEED       10      // Circle-Speed

// === ROTATIONAL AIM ASSIST ===
#define RAA_FORCE       7.0    // Strafe-Kraft
#define RAA_SWITCH     15      // Frames bis Richtungswechsel

// === HAIR TRIGGER ===
#define HAIR_THRESH     1.0

// === VARIABLEN ===
fix32 aa_angle;
int raa_timer;

main {
    // ─────────────────────────────────────────
    // 1. INPUT LESEN
    // ─────────────────────────────────────────
    fix32 rx = get_val(STICK_1_X);
    fix32 ry = get_val(STICK_1_Y);
    fix32 lx = get_val(STICK_2_X);
    fix32 ly = get_val(STICK_2_Y);

    // ─────────────────────────────────────────
    // 2. HAIR TRIGGER (ganz oben — aendert Button-Werte)
    // ─────────────────────────────────────────
    if(get_val(BUTTON_5) > HAIR_THRESH) set_val(BUTTON_5, 100.0);
    if(get_val(BUTTON_8) > HAIR_THRESH) set_val(BUTTON_8, 100.0);

    // ─────────────────────────────────────────
    // 3. STICKY AIM ASSIST (Rechter Stick)
    // ─────────────────────────────────────────
    // NUR bei ADS — kein Circle beim Hipfire!
    // Der Circle triggert den In-Game Aim Assist
    if(get_val(BUTTON_8)) {
        aa_angle += (fix32)AA_SPEED;
        if(aa_angle >= 360.0) aa_angle = 0.0;

        set_val(STICK_1_X, clamp(rx + cos(aa_angle) * AA_STRENGTH, -100.0, 100.0));
        set_val(STICK_1_Y, clamp(ry + sin(aa_angle) * AA_STRENGTH, -100.0, 100.0));
    }

    // ─────────────────────────────────────────
    // 4. ROTATIONAL AIM ASSIST (Linker Stick)
    // ─────────────────────────────────────────
    // Wechselt automatisch die Richtung alle X Frames
    // Nur bei ADS und wenn du nicht selbst stark strafest
    if(get_val(BUTTON_8)) {
        if(abs(lx) < 10.0) {
            raa_timer = raa_timer + 1;
            if(raa_timer >= RAA_SWITCH * 2) raa_timer = 0;

            if(raa_timer < RAA_SWITCH) {
                set_val(STICK_2_X, clamp(lx + RAA_FORCE, -100.0, 100.0));
            } else {
                set_val(STICK_2_X, clamp(lx - RAA_FORCE, -100.0, 100.0));
            }
        }
    }

    // ─────────────────────────────────────────
    // 5. ANTI-RECOIL (konstant, nur ADS+Fire)
    // ─────────────────────────────────────────
    if(get_val(BUTTON_5) && get_val(BUTTON_8)) {
        set_val(STICK_1_Y, clamp(get_val(STICK_1_Y) + RECOIL_V, -100.0, 100.0));
        if(RECOIL_H != 0.0) {
            set_val(STICK_1_X, clamp(get_val(STICK_1_X) + RECOIL_H, -100.0, 100.0));
        }
    }
}
